@@ -0,0 +1,11 @@
+/// Stable recording boundary used by the camera presentation layer.
+///
+/// The current implementation delegates to the Flutter camera repository.
+/// A realtime CameraX compositor can replace this backend later without
+/// changing CameraViewModel's session/orchestration logic.
+abstract class VideoRecordingBackend {
+  Future<void> start();
+
+  /// Finalizes the active native recording and returns its temporary file path.
+  Future<String> stop();
+}
